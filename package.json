{
  "name": "dehleez-modern",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "cross-env NODE_OPTIONS=--experimental-sqlite tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "cross-env NODE_OPTIONS=--experimental-sqlite node dist-server/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run --pool=threads",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.5"
  }
}
